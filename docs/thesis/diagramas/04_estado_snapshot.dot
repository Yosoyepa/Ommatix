node [shape=box, style="rounded,filled", fillcolor="#EDF4F6", color="#528593", fontname="DejaVu Sans", fontsize=11, margin="0.15,0.10", penwidth=1.1];
edge [color="#61788B", fontname="DejaVu Sans", fontsize=9, arrowsize=0.7, penwidth=1.0];
 u [label="UNINITIALIZED
