{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ommatix execute_action.input v1.0",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "geometry_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "target_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 1
    },
    "action": {
      "enum": [
        "click",
        "type",
        "scroll"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "direction": {
      "enum": [
        "up",
        "down"
      ]
    },
    "steps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "dry_run": {
      "type": "boolean",
      "default": true
    },
    "expected_effect": {
      "enum": [
        "none",
        "focus_changed",
        "value_updated",
        "scroll_moved",
        "visual_change"
      ],
      "default": "none"
    }
  },
  "required": [
    "request_id",
    "session_id",
    "snapshot_id",
    "geometry_epoch",
    "target_id",
    "expected_revision",
    "action"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "type"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "text"
        ]
      },
      "else": {
        "not": {
          "required": [
            "text"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "scroll"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "direction",
          "steps"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "direction"
              ]
            },
            {
              "required": [
                "steps"
              ]
            }
          ]
        }
      }
    }
  ]
}
