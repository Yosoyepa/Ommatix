{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ommatix execute_action.output v1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "status": {
      "description": "What is known about the action, and no more. simulated: validated, nothing sent. rejected: nothing sent. input_delivered: the actuator reported every input event handed to the system; no effect is verified. effect_observed: the declared expected_effect was checked; never after type. indeterminate: the delivery or its effect is uncertain; never retry automatically.",
      "enum": [
        "simulated",
        "rejected",
        "input_delivered",
        "effect_observed",
        "indeterminate"
      ]
    },
    "target_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "input_delivered": {
      "description": "Whether the actuator reported every input event handed to the system. It does not say that the application obeyed, nor how many typed characters arrived.",
      "type": "boolean"
    },
    "verified": {
      "description": "True only with effect_observed. After type it is never true: the engine knows that the keys were handed to the system and whether the screen changed, not how many characters arrived or which. An agent that needs the text must observe again and read what the application exposes.",
      "type": "boolean"
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "STALE_SNAPSHOT",
            "STALE_TARGET",
            "TARGET_NOT_FOUND",
            "AMBIGUOUS_TARGET",
            "NOT_ACTIONABLE",
            "POLICY_DENIED",
            "PERMISSION_DENIED",
            "CAPTURE_UNAVAILABLE",
            "INFERENCE_FAILED",
            "UNSUPPORTED_GEOMETRY",
            "INDETERMINATE_EFFECT",
            "REQUEST_CONFLICT",
            "CANCELLED",
            "LIMIT_EXCEEDED",
            "SESSION_MISMATCH",
            "EPOCH_MISMATCH"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "retryable": {
          "type": "boolean"
        },
        "next_step": {
          "enum": [
            "observe_again",
            "operator_review",
            "reduce_request",
            "reconcile_effect",
            "stop"
          ]
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "next_step"
      ],
      "additionalProperties": false
    },
    "observed_effect": {
      "description": "What the engine saw after the input. After type, visual_change only means that something on the screen changed after the keys.",
      "enum": [
        "none",
        "focus_changed",
        "value_updated",
        "scroll_moved",
        "visual_change",
        "unknown"
      ]
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "status",
    "target_id",
    "snapshot_id",
    "input_delivered",
    "verified"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "simulated",
              "rejected"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "input_delivered": {
            "const": false
          },
          "verified": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "rejected"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "error"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "effect_observed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "input_delivered": {
            "const": true
          },
          "verified": {
            "const": true
          }
        },
        "required": [
          "observed_effect"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "input_delivered"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "input_delivered": {
            "const": true
          },
          "verified": {
            "const": false
          }
        }
      }
    }
  ]
}
